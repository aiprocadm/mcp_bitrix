    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "taskId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "ID задачи"
      },
      "pageSize": {
        "description": "1..50, по умолчанию DEFAULT_PAGE_SIZE",
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "cursor": {
        "description": "Непрозрачный курсор из предыдущего ответа",
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "taskId"
    ],
    "additionalProperties": false

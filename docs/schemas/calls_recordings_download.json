{
  "name": "calls_recordings_download",
  "title": "Скачать записи звонков за период",
  "description": "Скачать на сервер (DOWNLOAD_DIR) записи разговоров за период одной командой: по сотруднику, направлению, длительности и другим фильтрам telephony_calls_list. Имена файлов: «дата_время_сотрудник_вх|исх_длительность_call<ID>», опись _список-файлов.csv (дата, сотрудник, направление, длительность, номер под маской, ID дела). Использовать, когда нужно прослушать или перевести в текст разговоры менеджера за неделю или месяц (затем call_transcribe по пути файла). Звонки без записи пропускаются. За вызов — до maxFiles новых файлов и maxSeconds секунд; если complete=false — повторить тот же вызов (скачанные пропустятся). Портал не меняется.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "from": {
        "type": "string",
        "maxLength": 40,
        "description": "Начало периода (ISO 8601, со смещением зоны)"
      },
      "to": {
        "type": "string",
        "maxLength": 40,
        "description": "Конец периода (ISO 8601)"
      },
      "userId": {
        "description": "Только звонки этого сотрудника",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "direction": {
        "description": "incoming — входящие (в т. ч. переадресованные и обратные), outgoing — исходящие",
        "type": "string",
        "enum": [
          "incoming",
          "outgoing"
        ]
      },
      "status": {
        "description": "answered — разговор состоялся (код 200), missed — не состоялся (для входящих — пропущен)",
        "type": "string",
        "enum": [
          "answered",
          "missed"
        ]
      },
      "minDurationSec": {
        "description": "Длительность от N секунд",
        "type": "integer",
        "minimum": 0,
        "maximum": 86400
      },
      "lineNumber": {
        "description": "Линия (номер портала, PORTAL_NUMBER)",
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "crmBound": {
        "description": "true — только привязанные к CRM, false — только без привязки",
        "type": "boolean"
      },
      "phoneLast4": {
        "description": "Последние 4 цифры номера абонента (номер в ответе остаётся скрытым)",
        "type": "string",
        "pattern": "^\\d{4}$"
      },
      "folder": {
        "default": "звонки",
        "description": "Подпапка внутри DOWNLOAD_DIR: до 3 частей через «/»",
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxFiles": {
        "default": 50,
        "description": "Сколько новых записей скачать за вызов",
        "type": "integer",
        "minimum": 1,
        "maximum": 300
      },
      "maxSeconds": {
        "default": 120,
        "description": "Сколько секунд работать за вызов",
        "type": "integer",
        "minimum": 10,
        "maximum": 600
      }
    },
    "required": [
      "from",
      "to",
      "folder",
      "maxFiles",
      "maxSeconds"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "folder": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "callId": {
                      "type": "number"
                    },
                    "startDate": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "userName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "type": {
                      "type": "string"
                    },
                    "durationSec": {
                      "type": "number"
                    },
                    "crmActivityId": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "recordFileId": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "saved",
                        "exists",
                        "too_large",
                        "failed",
                        "no_recording"
                      ]
                    },
                    "savedAs": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "callId",
                    "startDate",
                    "userName",
                    "type",
                    "durationSec",
                    "crmActivityId",
                    "recordFileId",
                    "status",
                    "savedAs"
                  ],
                  "additionalProperties": false
                }
              },
              "calls": {
                "type": "number"
              },
              "saved": {
                "type": "number"
              },
              "existed": {
                "type": "number"
              },
              "withoutRecording": {
                "type": "number"
              },
              "failed": {
                "type": "number"
              },
              "bytesSaved": {
                "type": "number"
              },
              "complete": {
                "type": "boolean"
              }
            },
            "required": [
              "folder",
              "path",
              "items",
              "calls",
              "saved",
              "existed",
              "withoutRecording",
              "failed",
              "bytesSaved",
              "complete"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              },
              "attempts": {
                "type": "number"
              },
              "page": {
                "type": "object",
                "properties": {
                  "nextCursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hasMore": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "nextCursor",
                  "hasMore"
                ],
                "additionalProperties": false
              },
              "completeness": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "unknown"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "requestId",
              "durationMs",
              "completeness",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "CONFIG_INVALID",
                  "BITRIX_AUTH_FAILED",
                  "BITRIX_SCOPE_MISSING",
                  "BITRIX_ACCESS_DENIED",
                  "BITRIX_APP_CONTEXT_REQUIRED",
                  "FEATURE_UNAVAILABLE",
                  "METHOD_NOT_ALLOWED",
                  "VALIDATION_ERROR",
                  "BITRIX_RATE_LIMITED",
                  "BITRIX_RESOURCE_LIMITED",
                  "BITRIX_TIMEOUT",
                  "BITRIX_UPSTREAM_ERROR",
                  "OPERATION_OUTCOME_UNKNOWN",
                  "NOT_FOUND",
                  "READ_ONLY_MODE",
                  "APPROVAL_REQUIRED",
                  "APPROVAL_EXPIRED",
                  "APPROVAL_MISMATCH",
                  "CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "PARTIAL_SUCCESS",
                  "FILE_TOO_LARGE",
                  "UNSAFE_FILE",
                  "AUDIT_UNAVAILABLE",
                  "ACCESS_DENIED",
                  "RATE_LIMITED",
                  "QUOTA_EXCEEDED",
                  "SUBSCRIPTION_INACTIVE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              }
            },
            "required": [
              "requestId",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error",
          "meta"
        ],
        "additionalProperties": false
      }
    ]
  }
}

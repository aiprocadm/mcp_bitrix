{
  "name": "crm_deal_products_get",
  "title": "Товары сделки",
  "description": "Товарные позиции сделки: товар, цена за единицу (с учётом скидок и налогов, как хранит Bitrix24), количество, скидка, НДС, и расчётный итог по строкам рядом с суммой сделки. Использовать перед crm_deal_products_replace и когда спрашивают «что в сделке». До 50 строк на страницу, продолжение — по cursor.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "dealId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "ID сделки"
      },
      "pageSize": {
        "description": "1..50, по умолчанию DEFAULT_PAGE_SIZE",
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "cursor": {
        "description": "Непрозрачный курсор из предыдущего ответа",
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "dealId"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",

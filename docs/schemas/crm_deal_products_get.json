      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "dealId": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "dealOpportunity": {
                "type": "number"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "productId": {
                      "type": "number"
                    },
                    "productName": {
                      "type": "string"
                    },
                    "price": {
                      "type": "number"
                    },
                    "quantity": {
                      "type": "number"
                    },
                    "discountTypeId": {
                      "type": "number"
                    },
                    "discountRate": {
                      "type": "number"
                    },
                    "discountSum": {
                      "type": "number"
                    },
                    "taxRate": {
                      "type": "number"
                    },
                    "taxIncluded": {
                      "type": "boolean"
                    },
                    "measureName": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "productId",
                    "productName",
                    "price",
                    "quantity",
                    "taxIncluded"
                  ],
                  "additionalProperties": false
                }
              },
              "returnedCount": {
                "type": "number"
              },
              "pageTotal": {
                "type": "number"
              },
              "stateHash": {
                "type": "string"
              }
            },
            "required": [
              "dealId",
              "currency",
              "items",
              "returnedCount",
              "pageTotal"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              },
              "attempts": {
                "type": "number"
              },
              "page": {
                "type": "object",

{
  "name": "telephony_calls_list",
  "title": "История звонков",
  "description": "История звонков портала за период (voximplant.statistic.get): время, направление, длительность, состоялся ли разговор, сотрудник (ФИО), привязка к CRM, recordFileId — ID файла записи на Диске. Использовать для вопросов «кто кому звонил», «сколько пропущенных», «звонки сотрудника за неделю». Фильтры сервера: direction, status (answered/missed), minDurationSec, lineNumber, crmBound, phoneLast4. mode=summary — вместо списка сводка по сотрудникам и линиям (всего, входящие, исходящие, отвечено, пропущено, минуты разговора) одним вызовом. Ссылок на записи нет: запись скачать — disk_file_download по recordFileId или calls_recordings_download за период; текст — call_transcribe. Номер абонента маскируется; includePhoneNumbers=true — только для роли administrator или по профилю выдачи. Полнота внешней АТС не гарантируется.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "from": {
        "type": "string",
        "maxLength": 40,
        "description": "Начало периода (ISO 8601, со смещением зоны)"
      },
      "to": {
        "type": "string",
        "maxLength": 40,
        "description": "Конец периода (ISO 8601)"
      },
      "userId": {
        "description": "Только звонки этого сотрудника",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "direction": {
        "description": "incoming — входящие (в т. ч. переадресованные и обратные), outgoing — исходящие",
        "type": "string",
        "enum": [
          "incoming",
          "outgoing"
        ]
      },
      "status": {
        "description": "answered — разговор состоялся (код 200), missed — не состоялся (для входящих — пропущен)",
        "type": "string",
        "enum": [
          "answered",
          "missed"
        ]
      },
      "minDurationSec": {
        "description": "Длительность от N секунд",
        "type": "integer",
        "minimum": 0,
        "maximum": 86400
      },
      "lineNumber": {
        "description": "Линия (номер портала, PORTAL_NUMBER)",
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "crmBound": {
        "description": "true — только привязанные к CRM, false — только без привязки",
        "type": "boolean"
      },
      "phoneLast4": {
        "description": "Последние 4 цифры номера абонента (номер в ответе остаётся скрытым)",
        "type": "string",
        "pattern": "^\\d{4}$"
      },
      "mode": {
        "default": "list",
        "description": "list — страница звонков; summary — сводка по сотрудникам и линиям за весь период",
        "type": "string",
        "enum": [
          "list",
          "summary"
        ]
      },
      "withRecordFiles": {
        "default": true,
        "description": "Найти ID файла записи в деле CRM, если его нет в статистике (внешние АТС)",
        "type": "boolean"
      },
      "compact": {
        "default": true,
        "description": "Короткий ответ: без callId, категории, текста причины и пустых полей",
        "type": "boolean"
      },
      "includePhoneNumbers": {
        "default": false,
        "description": "Показать номер абонента полностью (персональные данные; по умолчанию маска ***1234)",
        "type": "boolean"
      },
      "pageSize": {
        "description": "1..50, по умолчанию DEFAULT_PAGE_SIZE",
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "cursor": {
        "description": "Непрозрачный курсор из предыдущего ответа",
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "from",
      "to",
      "mode",
      "withRecordFiles",
      "compact",
      "includePhoneNumbers"
    ],
    "additionalProperties": false
  },

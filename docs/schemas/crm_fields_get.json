                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              }
            },
            "required": [
              "requestId",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error",
          "meta"
        ],
        "additionalProperties": false
      }
    ]
  }
}

{
  "name": "call_transcribe",
  "title": "Расшифровать запись звонка",
  "description": "Перевести запись разговора в текст на этом сервере (faster-whisper, запись никуда не отправляется): текст с отметками времени, для стерео-записей — по собеседникам («Собеседник 1/2» — каналы записи). Источник: activityId (дело-звонок, crmActivityId из telephony_calls_list), recordFileId (из telephony_calls_list) или file — путь в DOWNLOAD_DIR из calls_recordings_download («звонки/имя.mp3»). Использовать, когда нужно узнать, о чём говорили, что обещали, почему клиент не купил, а crm_call_transcript пуст. Текст сохраняется рядом с записью; повтор не распознаёт заново. Сохранить в CRM — crm_timeline_comment_add (crmTarget из ответа), с подтверждением. Выключено, пока администратор не задал TRANSCRIBE_PYTHON.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "activityId": {
        "description": "ID дела-звонка CRM",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "recordFileId": {
        "description": "ID файла записи на Диске",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "file": {
        "description": "Уже скачанная запись: путь внутри DOWNLOAD_DIR, например «звонки/2026-10-13_1530_…mp3»",
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "hotwords": {
        "description": "Дополнительные слова для распознавания через запятую (фамилии, названия)",
        "type": "string",
        "maxLength": 500
      },
      "maxChars": {
        "default": 20000,
        "description": "Предел длины текста в ответе",
        "type": "integer",
        "minimum": 500,
        "maximum": 100000
      }
    },
    "required": [
      "maxChars"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "durationSec": {
                "type": "number"
              },
              "speakers": {
                "type": "number"
              },
              "text": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean"
              },
              "transcriptFile": {
                "type": "string"
              },
              "cached": {
                "type": "boolean"
              },
              "crmTarget": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "entityType": {
                        "type": "string"
                      },
                      "recordId": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "entityType",
                      "recordId"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "file",
              "durationSec",
              "speakers",
              "text",
              "truncated",
              "transcriptFile",
              "cached",
              "crmTarget"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              },
              "attempts": {
                "type": "number"
              },
              "page": {
                "type": "object",
                "properties": {
                  "nextCursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hasMore": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "nextCursor",
                  "hasMore"
                ],
                "additionalProperties": false
              },
              "completeness": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "unknown"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "requestId",
              "durationMs",
              "completeness",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "CONFIG_INVALID",
                  "BITRIX_AUTH_FAILED",
                  "BITRIX_SCOPE_MISSING",
                  "BITRIX_ACCESS_DENIED",
                  "BITRIX_APP_CONTEXT_REQUIRED",
                  "FEATURE_UNAVAILABLE",
                  "METHOD_NOT_ALLOWED",
                  "VALIDATION_ERROR",
                  "BITRIX_RATE_LIMITED",
                  "BITRIX_RESOURCE_LIMITED",
                  "BITRIX_TIMEOUT",
                  "BITRIX_UPSTREAM_ERROR",
                  "OPERATION_OUTCOME_UNKNOWN",
                  "NOT_FOUND",
                  "READ_ONLY_MODE",
                  "APPROVAL_REQUIRED",
                  "APPROVAL_EXPIRED",
                  "APPROVAL_MISMATCH",
                  "CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "PARTIAL_SUCCESS",
                  "FILE_TOO_LARGE",
                  "UNSAFE_FILE",
                  "AUDIT_UNAVAILABLE",
                  "ACCESS_DENIED",
                  "RATE_LIMITED",
                  "QUOTA_EXCEEDED",
                  "SUBSCRIPTION_INACTIVE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              }
            },
            "required": [
              "requestId",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error",
          "meta"
        ],
        "additionalProperties": false
      }
    ]
  }
}

{
  "name": "chat_files_download",
  "title": "Скачать все файлы диалога",
  "description": "Скачать на сервер (DOWNLOAD_DIR) все файлы из переписки: документы, таблицы, картинки, записи — от новых к старым, имя «дата_ID_имя», опись _список-файлов.csv (дата, кто прислал, имя). dialogId — как в chat_messages_get. Использовать, когда пользователь просит забрать себе файлы чата или сотрудника. Портал не меняется, сообщения не отмечаются прочитанными. За вызов — до maxFiles новых файлов и maxSeconds секунд; если ответ complete=false — повторить с beforeMessageId=nextBeforeMessageId (уже скачанные пропускаются).",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "dialogId": {
        "type": "string",
        "pattern": "^(chat\\d{1,15}|sg\\d{1,15}|\\d{1,15})$",
        "description": "ID диалога"
      },
      "folder": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Подпапка внутри DOWNLOAD_DIR: до 3 частей через «/», например «переписка/Иванов»"
      },
      "beforeMessageId": {
        "description": "Продолжить с сообщений старее этого ID",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "maxFiles": {
        "default": 50,
        "description": "Сколько новых файлов скачать за вызов",
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "maxSeconds": {
        "default": 50,
        "description": "Сколько секунд работать за вызов",
        "type": "integer",
        "minimum": 10,
        "maximum": 600
      }
    },
    "required": [
      "dialogId",
      "maxFiles",
      "maxSeconds"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "dialogId": {
                "type": "string"
              },
              "folder": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "fileId": {
                      "type": "number"
                    },
                    "messageId": {
                      "type": "number"
                    },
                    "date": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "authorName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "size": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "saved",
                        "exists",
                        "too_large",
                        "failed"
                      ]
                    },
                    "savedAs": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "fileId",
                    "messageId",
                    "date",
                    "authorName",
                    "name",
                    "size",
                    "status",
                    "savedAs"
                  ],
                  "additionalProperties": false
                }
              },
              "saved": {
                "type": "number"
              },
              "existed": {
                "type": "number"
              },
              "skipped": {
                "type": "number"
              },
              "bytesSaved": {
                "type": "number"
              },
              "scannedMessages": {
                "type": "number"
              },
              "complete": {
                "type": "boolean"
              },
              "nextBeforeMessageId": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "dialogId",
              "folder",
              "path",
              "items",
              "saved",
              "existed",
              "skipped",
              "bytesSaved",
              "scannedMessages",
              "complete",
              "nextBeforeMessageId"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              },
              "attempts": {
                "type": "number"
              },
              "page": {
                "type": "object",
                "properties": {
                  "nextCursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hasMore": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "nextCursor",
                  "hasMore"
                ],
                "additionalProperties": false
              },
              "completeness": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "unknown"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "requestId",
              "durationMs",
              "completeness",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "CONFIG_INVALID",
                  "BITRIX_AUTH_FAILED",
                  "BITRIX_SCOPE_MISSING",
                  "BITRIX_ACCESS_DENIED",
                  "BITRIX_APP_CONTEXT_REQUIRED",
                  "FEATURE_UNAVAILABLE",
                  "METHOD_NOT_ALLOWED",
                  "VALIDATION_ERROR",
                  "BITRIX_RATE_LIMITED",
                  "BITRIX_RESOURCE_LIMITED",
                  "BITRIX_TIMEOUT",
                  "BITRIX_UPSTREAM_ERROR",
                  "OPERATION_OUTCOME_UNKNOWN",
                  "NOT_FOUND",
                  "READ_ONLY_MODE",
                  "APPROVAL_REQUIRED",
                  "APPROVAL_EXPIRED",
                  "APPROVAL_MISMATCH",
                  "CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "PARTIAL_SUCCESS",
                  "FILE_TOO_LARGE",
                  "UNSAFE_FILE",
                  "AUDIT_UNAVAILABLE",
                  "ACCESS_DENIED",
                  "RATE_LIMITED",
                  "QUOTA_EXCEEDED",
                  "SUBSCRIPTION_INACTIVE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              }
            },
            "required": [
              "requestId",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error",
          "meta"
        ],
        "additionalProperties": false
      }
    ]
  }
}

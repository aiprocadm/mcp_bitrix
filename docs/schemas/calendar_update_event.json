{
  "name": "calendar_update_event",
  "title": "Изменить событие календаря",
  "description": "Изменить существующее событие календаря Bitrix24 (calendar.event.update): название, время, описание, место, календарь, участников. Использовать, когда пользователь просит перенести встречу или поправить событие. Даты — ISO с явным смещением, timezone — IANA; to позже from. attendeeIds — новый полный список: план покажет, кто добавится и кто будет удалён (им придут уведомления). Для повторяющегося события обязателен recurrenceScope (this/next требуют occurrenceDate — дату вхождения YYYY-MM-DD). expectedStateHash из dryRun защищает от одновременного изменения. Порядок: APPROVAL_REQUIRED → подтверждение человеком → повтор с approvalId.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "eventId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "type": {
        "type": "string",
        "enum": [
          "user",
          "group",
          "company"
        ],
        "description": "user — календарь сотрудника, group — рабочей группы, company — общий календарь компании"
      },
      "ownerId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "ID сотрудника (user) или группы (group); для company игнорируется (0)"
      },
      "patch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "from": {
            "description": "Новое начало: ISO с зоной, либо YYYY-MM-DD при allDay",
            "type": "string",
            "maxLength": 40
          },
          "to": {
            "description": "Новое окончание: ISO с зоной, либо YYYY-MM-DD при allDay",
            "type": "string",
            "maxLength": 40
          },
          "allDay": {
            "description": "Смена «весь день» требует и from, и to",
            "type": "boolean"
          },
          "timezone": {
            "description": "IANA-зона события",
            "type": "string",
            "maxLength": 64
          },
          "location": {
            "type": "string",
            "maxLength": 255
          },
          "sectionId": {
            "description": "Перенести в другой календарь (раздел)",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "accessibility": {
            "type": "string",
            "enum": [
              "busy",
              "absent",
              "quest",
              "free"
            ]
          },
          "importance": {
            "type": "string",
            "enum": [
              "high",
              "normal",
              "low"
            ]
          },
          "privateEvent": {
            "type": "boolean"
          },
          "attendeeIds": {
            "description": "Новый ПОЛНЫЙ список участников; пустой — встреча станет событием без участников",
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "additionalProperties": false
      },
      "recurrenceScope": {
        "type": "string",
        "enum": [
          "this",
          "next",
          "all"
        ],
        "description": "Для повторяющегося события: this — только это вхождение, next — это и последующие, all — вся серия"
      },
      "occurrenceDate": {
        "description": "Дата изменяемого вхождения (для recurrenceScope this/next)",
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "dryRun": {
        "default": false,
        "description": "Только рассчитать план и проверки; ничего не записывать и не создавать подтверждение",
        "type": "boolean"
      },
      "idempotencyKey": {
        "description": "UUID, одинаковый при повторе того же намерения; обязателен, если dryRun=false",
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "approvalId": {
        "description": "operationId, подтверждённый человеком через npm run approval:review",
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "expectedStateHash": {
        "description": "Хеш состояния объекта из предыдущего чтения; при расхождении — CONFLICT",
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "eventId",
      "type",
      "patch",
      "dryRun"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "number"
              },
              "dryRun": {
                "type": "boolean"
              },
              "plan": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "validationLevel": {
                "type": "string"
              },
              "operationId": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              },
              "replayed": {
                "type": "boolean"
              },
              "stateHash": {
                "type": "string"
              },
              "newEventId": {
                "type": "number"
              }
            },
            "required": [
              "eventId"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              },
              "attempts": {
                "type": "number"
              },
              "page": {
                "type": "object",
                "properties": {
                  "nextCursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hasMore": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "nextCursor",
                  "hasMore"
                ],
                "additionalProperties": false
              },
              "completeness": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "unknown"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "requestId",
              "durationMs",
              "completeness",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "CONFIG_INVALID",
                  "BITRIX_AUTH_FAILED",
                  "BITRIX_SCOPE_MISSING",
                  "BITRIX_ACCESS_DENIED",
                  "BITRIX_APP_CONTEXT_REQUIRED",
                  "FEATURE_UNAVAILABLE",
                  "METHOD_NOT_ALLOWED",
                  "VALIDATION_ERROR",
                  "BITRIX_RATE_LIMITED",
                  "BITRIX_RESOURCE_LIMITED",
                  "BITRIX_TIMEOUT",
                  "BITRIX_UPSTREAM_ERROR",
                  "OPERATION_OUTCOME_UNKNOWN",
                  "NOT_FOUND",
                  "READ_ONLY_MODE",
                  "APPROVAL_REQUIRED",
                  "APPROVAL_EXPIRED",
                  "APPROVAL_MISMATCH",
                  "CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "PARTIAL_SUCCESS",
                  "FILE_TOO_LARGE",
                  "UNSAFE_FILE",
                  "AUDIT_UNAVAILABLE",
                  "ACCESS_DENIED",
                  "RATE_LIMITED",
                  "QUOTA_EXCEEDED",
                  "SUBSCRIPTION_INACTIVE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              }
            },
            "required": [
              "requestId",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error",
          "meta"
        ],
        "additionalProperties": false
      }
    ]
  }
}

          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "fullName": {
                      "type": "string"
                    },
                    "position": {
                      "type": "string"
                    },
                    "active": {
                      "type": "boolean"
                    },
                    "userType": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "fullName",
                    "position",
                    "active",
                    "userType"
                  ],
                  "additionalProperties": false
                }
              },

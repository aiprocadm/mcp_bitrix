{
  "name": "crm_export",
  "title": "Выгрузить записи CRM в файл",
  "description": "Выгрузить ВСЕ записи CRM по фильтру (сделки, лиды, контакты, компании) в файл XLSX или CSV в папке скачиваний сервера (DOWNLOAD_DIR) одной командой: сервер сам перебирает все страницы, добавляет колонки с именами (ответственный → ФИО, компания → название, стадия, источник) и ссылку на карточку. Использовать вместо листания crm_list_records, когда записей больше пары страниц или нужна таблица: «все компании Иванова», «все лиды за год». В ответе — путь к файлу, число строк и первые 5 строк. Фильтр как в crm_list_records; «!%ПОЛЕ» (не содержит) проверяется сервером. За вызов — до maxSeconds секунд; если complete=false — повторить с cursor (тот же файл продолжится). Портал не меняется.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "entityType": {
        "type": "string",
        "enum": [
          "deal",
          "lead",
          "contact",
          "company"
        ],
        "description": "Тип сущности классического CRM: deal (сделка), lead (лид), contact (контакт), company (компания)"
      },
      "filter": {
        "default": {},
        "description": "Фильтр как в crm_list_records: {\">=DATE_CREATE\": \"2026-01-01\", \"ASSIGNED_BY_ID\": 5, \"!%TITLE\": \"тест\"}",
        "type": "object",
        "propertyNames": {
          "type": "string",
          "maxLength": 120
        },
        "additionalProperties": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            {
              "maxItems": 100,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          ]
        }
      },
      "fields": {
        "description": "Колонки (поля портала); по умолчанию ключевые поля сущности",
        "maxItems": 60,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 100
        }
      },
      "format": {
        "default": "xlsx",
        "description": "Формат файла: xlsx (Excel) или csv",
        "type": "string",
        "enum": [
          "csv",
          "xlsx"
        ]
      },
      "withNames": {
        "default": true,
        "description": "Добавить колонки с именами для ID сотрудников, компаний, контактов, стадий",
        "type": "boolean"
      },
      "withLinks": {
        "default": true,
        "description": "Колонка со ссылкой на карточку",
        "type": "boolean"
      },
      "folder": {
        "default": "выгрузки",
        "description": "Подпапка внутри DOWNLOAD_DIR: до 3 частей через «/»",
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "fileName": {
        "description": "Имя файла без расширения",
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "maxRows": {
        "default": 100000,
        "description": "Предел строк файла",
        "type": "integer",
        "minimum": 1,
        "maximum": 300000
      },
      "maxSeconds": {
        "default": 90,
        "description": "Сколько секунд работать за вызов; не успел — complete=false и cursor для продолжения",
        "type": "integer",
        "minimum": 1,
        "maximum": 600
      },
      "cursor": {
        "description": "cursor из прошлого ответа с complete=false: продолжить ту же выгрузку (остальные параметры те же)",
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "entityType",
      "filter",
      "format",
      "withNames",
      "withLinks",
      "folder",
      "maxRows",
      "maxSeconds"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "entityType": {
                "type": "string"
              },
              "complete": {
                "type": "boolean"
              },
              "cursor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rows": {
                "type": "number"
              },
              "scanned": {
                "type": "number"
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fileName": {
                "type": "string"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "preview": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "truncatedByMaxRows": {
                "type": "boolean"
              }
            },
            "required": [
              "entityType",
              "complete",
              "cursor",
              "rows",
              "scanned",
              "path",
              "fileName",
              "columns",
              "preview",
              "truncatedByMaxRows"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              },
              "attempts": {
                "type": "number"
              },
              "page": {
                "type": "object",
                "properties": {
                  "nextCursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hasMore": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "nextCursor",
                  "hasMore"
                ],
                "additionalProperties": false
              },
              "completeness": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "unknown"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "requestId",
              "durationMs",
              "completeness",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "CONFIG_INVALID",
                  "BITRIX_AUTH_FAILED",
                  "BITRIX_SCOPE_MISSING",
                  "BITRIX_ACCESS_DENIED",
                  "BITRIX_APP_CONTEXT_REQUIRED",
                  "FEATURE_UNAVAILABLE",
                  "METHOD_NOT_ALLOWED",
                  "VALIDATION_ERROR",
                  "BITRIX_RATE_LIMITED",
                  "BITRIX_RESOURCE_LIMITED",
                  "BITRIX_TIMEOUT",
                  "BITRIX_UPSTREAM_ERROR",
                  "OPERATION_OUTCOME_UNKNOWN",
                  "NOT_FOUND",
                  "READ_ONLY_MODE",
                  "APPROVAL_REQUIRED",
                  "APPROVAL_EXPIRED",
                  "APPROVAL_MISMATCH",
                  "CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "PARTIAL_SUCCESS",
                  "FILE_TOO_LARGE",
                  "UNSAFE_FILE",
                  "AUDIT_UNAVAILABLE",
                  "ACCESS_DENIED",
                  "RATE_LIMITED",
                  "QUOTA_EXCEEDED",
                  "SUBSCRIPTION_INACTIVE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              }
            },
            "required": [
              "requestId",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error",
          "meta"
        ],
        "additionalProperties": false
      }
    ]
  }
}

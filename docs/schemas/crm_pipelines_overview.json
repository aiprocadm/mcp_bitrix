                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "count": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "sourceId",
                    "name",
                    "count"
                  ],
                  "additionalProperties": false
                }
              },
              "totals": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "number"
                  },
                  "sums": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "currency": {

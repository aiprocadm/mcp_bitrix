{
  "name": "crm_pipelines_overview",
  "title": "Сводка по всем воронкам или по лидам",
  "description": "entityType=deal — количество и суммы сделок по КАЖДОЙ воронке и её стадиям за период (выиграно/проиграно/в работе); entityType=lead — лиды по стадиям и по источникам (откуда пришли). Использовать для вопросов «как дела во всех воронках», «сколько лидов за месяц и откуда», «сколько лидов провалено». Одна воронка подробно — crm_pipeline_summary. Считается по ограниченной выборке (maxRecords, лимит времени): ответ сообщает scannedCount, hasMore и полноту — сужайте период. Суммы в разных валютах не складываются. Это снимок текущих стадий, не историческая конверсия.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "entityType": {
        "type": "string",
        "enum": [
          "deal",
          "lead"
        ],
        "description": "deal — все воронки сделок, lead — лиды"
      },
      "dateField": {
        "default": "DATE_CREATE",
        "description": "Поле даты периода: сделки — DATE_CREATE/CLOSEDATE/BEGINDATE/DATE_MODIFY, лиды — DATE_CREATE/DATE_MODIFY/DATE_CLOSED",
        "type": "string",
        "enum": [
          "DATE_CREATE",
          "CLOSEDATE",
          "BEGINDATE",
          "DATE_MODIFY",
          "DATE_CLOSED"
        ]
      },
      "from": {
        "type": "string",
        "maxLength": 40,
        "description": "Начало периода (включительно)"
      },
      "to": {
        "type": "string",
        "maxLength": 40,
        "description": "Конец периода (включительно)"
      },
      "assignedById": {
        "description": "Только этого ответственного",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "maxRecords": {
        "description": "Предел просмотренных записей; по умолчанию MAX_AGGREGATION_RECORDS",
        "type": "integer",
        "minimum": 1,
        "maximum": 50000
      }
    },
    "required": [
      "entityType",
      "dateField",
      "from",
      "to"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "entityType": {
                "type": "string",
                "enum": [
                  "deal",
                  "lead"
                ]
              },
              "dateField": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "assignedById": {
                "type": "number"
              },
              "asOf": {
                "type": "string"
              },
              "scannedCount": {
                "type": "number"
              },
              "hasMore": {
                "type": "boolean"
              },
              "stoppedBy": {
                "type": "string",
                "enum": [
                  "complete",
                  "maxRecords",
                  "timeLimit"
                ]
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "categoryId": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "count": {
                      "type": "number"
                    },
                    "sums": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "currency": {
                            "type": "string"
                          },
                          "amount": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "currency",
                          "amount"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "won": {
                      "type": "number"
                    },
                    "lost": {
                      "type": "number"
                    },
                    "inProgress": {
                      "type": "number"
                    },
                    "stages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "stageId": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "semantics": {
                            "type": "string",
                            "enum": [
                              "P",
                              "S",
                              "F"
                            ]
                          },
                          "count": {
                            "type": "number"
                          },
                          "sums": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "currency": {
                                  "type": "string"
                                },
                                "amount": {
                                  "type": "number"
                                }
                              },
                              "required": [
                                "currency",
                                "amount"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "stageId",
                          "name",
                          "semantics",
                          "count",
                          "sums"
                        ],

                        }
                      },
                      "required": [
                        "currency",
                        "amount"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "count",
                  "sums"
                ],
                "additionalProperties": false
              }
            },
            "required": [

{
  "name": "kb_legacy_article_update",
  "title": "Дописать или заменить блоки статьи",
  "description": "Изменить черновик статьи классической базы знаний. Использовать, когда пользователь просит дописать статью (mode=append: новые блоки landing.landing.addblock после последнего блока) или переписать конкретные блоки (mode=replace: landing.block.updatecontent только для blockIds, content — по элементу на блок). Для replace сначала прочитайте статью (kb_legacy_article_get) и передайте её stateHash как expectedStateHash: при расхождении — CONFLICT. title меняет название (landing.landing.update). Изменения остаются в черновике (publish=false). Порядок: APPROVAL_REQUIRED с «было → станет» → подтверждение человеком → повтор с approvalId.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "articleId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "ID статьи"
      },
      "mode": {
        "type": "string",
        "enum": [
          "append",
          "replace"
        ]
      },
      "blockIds": {
        "description": "Для replace обязательно: ID заменяемых блоков из kb_legacy_article_get",
        "minItems": 1,
        "maxItems": 20,
        "type": "array",
        "items": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "content": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          }
        ],
        "description": "Содержимое: строка (один блок) или массив строк (по блоку на элемент, порядок сохраняется). До 20 блоков, 64 KiB на блок, 256 KiB всего"
      },
      "format": {
        "default": "text",
        "description": "text — обычный текст (абзацы по пустой строке); html — HTML, будет очищен по allowlist",
        "type": "string",
        "enum": [
          "text",
          "html"
        ]
      },
      "blockCode": {
        "description": "Для append: код блока из репозитория (как в kb_legacy_article_create)",
        "type": "string",
        "pattern": "^(repo_\\d{1,10}|[a-z0-9][a-z0-9_.-]{0,99})$"
      },
      "title": {
        "description": "Новое название статьи",
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "publish": {
        "default": false,
        "description": "Всегда false: статья остаётся черновиком. Публикация — отдельным kb_legacy_article_publish",
        "type": "boolean"
      },
      "scope": {
        "default": "KNOWLEDGE",
        "description": "Внутренний scope landing: KNOWLEDGE — базы знаний, GROUP — базы знаний групп. Это не REST-разрешение landing",
        "type": "string",
        "enum": [
          "KNOWLEDGE",
          "GROUP"
        ]
      },
      "dryRun": {
        "default": false,
        "description": "Только рассчитать план и проверки; ничего не записывать и не создавать подтверждение",
        "type": "boolean"
      },
      "idempotencyKey": {
        "description": "UUID, одинаковый при повторе того же намерения; обязателен, если dryRun=false",
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "approvalId": {
        "description": "operationId, подтверждённый человеком через npm run approval:review",
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "expectedStateHash": {
        "description": "Хеш состояния объекта из предыдущего чтения; при расхождении — CONFLICT",
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "articleId",
      "mode",
      "content",
      "format",
      "publish",
      "scope",
      "dryRun"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "articleId": {
                "type": "number"
              },
              "mode": {
                "type": "string"
              },
              "changedBlockIds": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "addedBlockIds": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "draft": {
                "type": "boolean"
              },
              "stateHash": {
                "type": "string"
              },
              "dryRun": {
                "type": "boolean"
              },
              "plan": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "validationLevel": {
                "type": "string"
              },
              "operationId": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              },
              "replayed": {
                "type": "boolean"
              }
            },
            "required": [
              "articleId",
              "mode"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              },
              "attempts": {
                "type": "number"
              },
              "page": {
                "type": "object",
                "properties": {
                  "nextCursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hasMore": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "nextCursor",
                  "hasMore"
                ],
                "additionalProperties": false
              },
              "completeness": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "unknown"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "requestId",
              "durationMs",
              "completeness",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "CONFIG_INVALID",
                  "BITRIX_AUTH_FAILED",
                  "BITRIX_SCOPE_MISSING",
                  "BITRIX_ACCESS_DENIED",
                  "BITRIX_APP_CONTEXT_REQUIRED",
                  "FEATURE_UNAVAILABLE",
                  "METHOD_NOT_ALLOWED",
                  "VALIDATION_ERROR",
                  "BITRIX_RATE_LIMITED",
                  "BITRIX_RESOURCE_LIMITED",
                  "BITRIX_TIMEOUT",
                  "BITRIX_UPSTREAM_ERROR",
                  "OPERATION_OUTCOME_UNKNOWN",
                  "NOT_FOUND",
                  "READ_ONLY_MODE",
                  "APPROVAL_REQUIRED",
                  "APPROVAL_EXPIRED",
                  "APPROVAL_MISMATCH",
                  "CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "PARTIAL_SUCCESS",
                  "FILE_TOO_LARGE",
                  "UNSAFE_FILE",
                  "AUDIT_UNAVAILABLE",
                  "ACCESS_DENIED",
                  "RATE_LIMITED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              }
            },
            "required": [
              "requestId",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error",
          "meta"
        ],
        "additionalProperties": false
      }
    ]
  }
}

{
  "name": "disk_search_files",
  "title": "Поиск файлов по имени в папке",
  "description": "Найти файлы (и при необходимости папки) по части имени в выбранной области Диска: корень хранилища (storageId) или папка (rootFolderId). Использовать, когда пользователь помнит название файла и примерное место. Это ограниченный обход через disk.*.getChildren, а не глобальный поиск по порталу и не поиск по содержимому. recursive=false — только сама папка; recursive=true — вложенные папки до maxDepth (≤5), всего не больше maxVisited (≤500) просмотренных объектов. Если лимит достигнут, ответ помечается partial с причиной SCAN_LIMIT_REACHED. Продолжение — по cursor.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "storageId": {
        "description": "Искать от корня хранилища",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "rootFolderId": {
        "description": "Искать от этой папки",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "nameQuery": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "description": "Часть имени, без учёта регистра"
      },
      "recursive": {
        "default": false,
        "type": "boolean"
      },
      "maxDepth": {
        "default": 3,
        "description": "Глубина вложенных папок при recursive=true",
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "maxVisited": {
        "default": 200,
        "description": "Сколько объектов просмотреть максимум",
        "type": "integer",
        "minimum": 1,
        "maximum": 500
      },
      "objectType": {
        "default": "file",
        "type": "string",
        "enum": [
          "file",
          "folder",
          "all"
        ]
      },
      "pageSize": {
        "description": "1..50, по умолчанию DEFAULT_PAGE_SIZE",
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "cursor": {
        "description": "Непрозрачный курсор из предыдущего ответа",
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "nameQuery",
      "recursive",
      "maxDepth",
      "maxVisited",
      "objectType"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "file",
                        "folder"
                      ]
                    },
                    "storageId": {
                      "type": "number"
                    },
                    "parentId": {
                      "type": "number"
                    },
                    "size": {
                      "type": "number"
                    },
                    "createTime": {
                      "type": "string"
                    },
                    "updateTime": {
                      "type": "string"
                    },
                    "createdBy": {
                      "type": "number"
                    },
                    "updatedBy": {
                      "type": "number"
                    },
                    "deleted": {
                      "type": "boolean"
                    },
                    "detailUrl": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "type",
                    "deleted",
                    "path"
                  ],
                  "additionalProperties": false
                }
              },
              "returnedCount": {
                "type": "number"
              },
              "coverage": {
                "type": "object",
                "properties": {
                  "scannedObjects": {
                    "type": "number"
                  },
                  "foldersListed": {
                    "type": "number"
                  },
                  "pendingFolders": {
                    "type": "number"
                  },
                  "depthLimitedFolders": {
                    "type": "number"
                  },
                  "maxDepth": {
                    "type": "number"
                  },
                  "maxVisited": {
                    "type": "number"
                  },
                  "recursive": {
                    "type": "boolean"
                  },
                  "scanLimitReached": {
                    "type": "boolean"
                  },
                  "scanFinished": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "const": "SCAN_LIMIT_REACHED"
                  }
                },
                "required": [
                  "scannedObjects",
                  "foldersListed",
                  "pendingFolders",
                  "depthLimitedFolders",
                  "maxDepth",
                  "maxVisited",
                  "recursive",
                  "scanLimitReached",
                  "scanFinished"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "items",
              "returnedCount",
              "coverage"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              },
              "attempts": {
                "type": "number"
              },
              "page": {
                "type": "object",
                "properties": {
                  "nextCursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hasMore": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "nextCursor",
                  "hasMore"
                ],
                "additionalProperties": false
              },
              "completeness": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "unknown"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "requestId",
              "durationMs",
              "completeness",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "CONFIG_INVALID",
                  "BITRIX_AUTH_FAILED",
                  "BITRIX_SCOPE_MISSING",
                  "BITRIX_ACCESS_DENIED",
                  "BITRIX_APP_CONTEXT_REQUIRED",
                  "FEATURE_UNAVAILABLE",
                  "METHOD_NOT_ALLOWED",
                  "VALIDATION_ERROR",
                  "BITRIX_RATE_LIMITED",
                  "BITRIX_RESOURCE_LIMITED",
                  "BITRIX_TIMEOUT",
                  "BITRIX_UPSTREAM_ERROR",
                  "OPERATION_OUTCOME_UNKNOWN",
                  "NOT_FOUND",
                  "READ_ONLY_MODE",
                  "APPROVAL_REQUIRED",
                  "APPROVAL_EXPIRED",
                  "APPROVAL_MISMATCH",
                  "CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "PARTIAL_SUCCESS",
                  "FILE_TOO_LARGE",
                  "UNSAFE_FILE",
                  "AUDIT_UNAVAILABLE",
                  "ACCESS_DENIED",
                  "RATE_LIMITED",
                  "QUOTA_EXCEEDED",
                  "SUBSCRIPTION_INACTIVE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              }
            },
            "required": [
              "requestId",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error",
          "meta"
        ],
        "additionalProperties": false
      }
    ]
  }
}

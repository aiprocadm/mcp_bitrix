{
  "name": "crm_get_record",
  "title": "Карточка записи CRM",
  "description": "Карточка записи CRM по ID в рамках доступных полей: сделка, лид, контакт, компания (crm.<entity>.get, поля ВЕРХНИЙ_РЕГИСТР), элемент смарт-процесса (entityType=smart + entityTypeId) , новый счёт (invoice) или коммерческое предложение (quote) через crm.item.get (поля camelCase). Использовать, когда известен ID и нужны поля записи. Возвращает stateHash для expectedStateHash в crm_update_record/crm_delete_record. include добавляет небольшие связанные блоки (дела, комментарии, товары) с отдельными лимитами и полнотой; бинарные вложения не скачиваются.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "entityType": {
        "type": "string",
        "enum": [
          "deal",
          "lead",
          "contact",
          "company",
          "smart",
          "invoice",
          "quote"
        ],
        "description": "Тип записи CRM: deal, lead, contact, company (классические, поля ВЕРХНИЙ_РЕГИСТР); smart — элемент смарт-процесса (нужен entityTypeId), invoice — новый счёт (entityTypeId=31), quote — коммерческое предложение (entityTypeId=7, без воронок); у smart/invoice/quote поля camelCase"
      },
      "entityTypeId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 1000000,
        "description": "Только для entityType=smart: entityTypeId смарт-процесса из smart_process_types_list (не id типа crm.type)"
      },
      "id": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "ID записи"
      },
      "select": {
        "description": "Ограничить набор полей; по умолчанию все доступные",
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 100
        }
      },
      "include": {
        "description": "Связанные блоки, каждый со своим лимитом и completeness: activities (до 10 дел), comments (до 10 комментариев таймлайна, только классические сущности), products (до 20 товарных позиций: сделка, лид, smart, invoice, quote). Полные списки — отдельные инструменты",
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "activities",
            "comments",
            "products"
          ]
        }
      }
    },
    "required": [
      "entityType",
      "id"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "entityType": {
                "type": "string",
                "enum": [
                  "deal",
                  "lead",
                  "contact",
                  "company",
                  "smart",
                  "invoice",
                  "quote"
                ],

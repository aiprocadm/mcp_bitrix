        "description": "ID складов (warehouse_list)",
        "minItems": 1,
        "maxItems": 50,
        "type": "array",
        "items": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "productIds": {

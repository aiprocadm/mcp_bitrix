{
  "name": "catalog_price_set",
  "title": "Установить цену товара",
  "description": "Создать или изменить одну цену товара/услуги/вариации заданного типа цены (catalog.price.add или catalog.price.update по результату catalog.price.list). Использовать, когда пользователь явно просит поставить цену. amount — строка \"1234.10\" (не число, без экспоненты и минуса, знаков после точки не больше, чем у валюты); currency — код валюты портала; priceTypeId — тип цены (например, базовая). План показывает режим (создание/изменение) и «было → станет»; stateHash из dryRun защищает от параллельного изменения (CONFLICT). Порядок: APPROVAL_REQUIRED → подтверждение → повтор с approvalId.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "productId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "ID товара/услуги/вариации"
      },
      "productKind": {
        "default": "product",
        "type": "string",
        "enum": [
          "product",
          "service",
          "offer"
        ],
        "description": "Вид позиции: product — простой товар, service — услуга, offer — вариация (торговое предложение)"
      },
      "priceTypeId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "ID типа цены (catalog.priceType.list)"
      },
      "amount": {
        "type": "string",
        "maxLength": 16,
        "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,3})?$",
        "description": "Сумма строкой: \"1234.10\" (не число; не \"1e3\", не отрицательная; точность — по валюте)"
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "description": "Код валюты портала, например RUB"
      },
      "dryRun": {
        "default": false,
        "description": "Только рассчитать план и проверки; ничего не записывать и не создавать подтверждение",
        "type": "boolean"
      },
      "idempotencyKey": {
        "description": "UUID, одинаковый при повторе того же намерения; обязателен, если dryRun=false",
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "approvalId": {
        "description": "operationId, подтверждённый человеком через npm run approval:review",
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "expectedStateHash": {
        "description": "Хеш состояния объекта из предыдущего чтения; при расхождении — CONFLICT",
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "productId",
      "productKind",
      "priceTypeId",
      "amount",
      "currency",
      "dryRun"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "number"
              },
              "priceTypeId": {
                "type": "number"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "create",
                  "update"
                ]
              },
              "priceId": {
                "type": "number"
              },
              "amount": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "stateHash": {
                "type": "string"
              },
              "dryRun": {
                "type": "boolean"
              },
              "plan": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "validationLevel": {
                "type": "string"
              },
              "operationId": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              },
              "replayed": {
                "type": "boolean"
              }
            },
            "required": [
              "productId",
              "priceTypeId",
              "amount",
              "currency"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              },
              "attempts": {
                "type": "number"
              },
              "page": {
                "type": "object",
                "properties": {
                  "nextCursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hasMore": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "nextCursor",
                  "hasMore"
                ],
                "additionalProperties": false
              },
              "completeness": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "unknown"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "requestId",
              "durationMs",
              "completeness",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "CONFIG_INVALID",
                  "BITRIX_AUTH_FAILED",
                  "BITRIX_SCOPE_MISSING",
                  "BITRIX_ACCESS_DENIED",
                  "BITRIX_APP_CONTEXT_REQUIRED",
                  "FEATURE_UNAVAILABLE",
                  "METHOD_NOT_ALLOWED",
                  "VALIDATION_ERROR",
                  "BITRIX_RATE_LIMITED",
                  "BITRIX_RESOURCE_LIMITED",
                  "BITRIX_TIMEOUT",
                  "BITRIX_UPSTREAM_ERROR",
                  "OPERATION_OUTCOME_UNKNOWN",
                  "NOT_FOUND",
                  "READ_ONLY_MODE",
                  "APPROVAL_REQUIRED",
                  "APPROVAL_EXPIRED",
                  "APPROVAL_MISMATCH",
                  "CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "PARTIAL_SUCCESS",
                  "FILE_TOO_LARGE",
                  "UNSAFE_FILE",
                  "AUDIT_UNAVAILABLE",
                  "ACCESS_DENIED",
                  "RATE_LIMITED",
                  "QUOTA_EXCEEDED",
                  "SUBSCRIPTION_INACTIVE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              }
            },
            "required": [
              "requestId",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error",
          "meta"
        ],
        "additionalProperties": false
      }
    ]
  }
}

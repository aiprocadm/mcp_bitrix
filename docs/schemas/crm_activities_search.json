{
  "name": "crm_activities_search",
  "title": "Поиск дел CRM по всему порталу",
  "description": "Дела CRM по всему порталу (crm.activity.list): письма, звонки, встречи, дела «Сделать». Фильтры: kind (email/call/meeting/task/todo) или providerId (CRM_EMAIL, VOXIMPLANT_CALL, CRM_TODO…), direction (incoming/outgoing), период по dateField, часть темы, ответственный, выполнено, boundTo — все дела, привязанные к записи (в т. ч. звонки, где запись не владелец). Использовать для вопросов «какие письма об оплате пришли сегодня», «какие звонки были по сделкам за неделю», «все звонки клиента». includeDescription — текст (у писем тело письма, HTML → текст, обрезка descriptionMaxChars). Контакты участников и вложения не отдаются. До 50 дел на страницу, продолжение — по cursor; без периода и boundTo выборка по всему порталу очень большая.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "kind": {
        "description": "email — письма, call — звонки, meeting — встречи, task — старые задачи CRM, todo — дела «Сделать»",
        "type": "string",
        "enum": [
          "email",
          "call",
          "meeting",
          "task",
          "todo"
        ]
      },
      "providerId": {
        "description": "Точный PROVIDER_ID, например CRM_EMAIL, VOXIMPLANT_CALL, CRM_TODO, IMOPENLINES_SESSION",
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,59}$"
      },
      "direction": {
        "type": "string",
        "enum": [
          "incoming",
          "outgoing"
        ]
      },
      "dateField": {
        "default": "CREATED",
        "type": "string",
        "enum": [
          "CREATED",
          "START_TIME",
          "DEADLINE",
          "LAST_UPDATED"
        ]
      },
      "from": {
        "description": "Начало периода (ISO 8601 с зоной)",
        "type": "string",
        "maxLength": 40
      },
      "to": {
        "description": "Конец периода",
        "type": "string",
        "maxLength": 40
      },
      "subjectContains": {
        "description": "Часть темы (SUBJECT), например «оплат»",
        "type": "string",
        "minLength": 2,
        "maxLength": 200
      },
      "responsibleId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "completed": {
        "type": "boolean"
      },
      "boundTo": {
        "description": "Только дела, привязанные к этой записи (фильтр BINDINGS)",
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string",
            "enum": [
              "deal",
              "lead",
              "contact",
              "company"
            ],
            "description": "Тип сущности классического CRM: deal (сделка), lead (лид), contact (контакт), company (компания)"
          },
          "recordId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "entityType",
          "recordId"
        ],
        "additionalProperties": false
      },
      "includeDescription": {
        "default": false,
        "type": "boolean"
      },
      "descriptionMaxChars": {
        "default": 2000,
        "type": "integer",
        "minimum": 200,
        "maximum": 20000
      },
      "pageSize": {
        "description": "1..50, по умолчанию DEFAULT_PAGE_SIZE",
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "cursor": {
        "description": "Непрозрачный курсор из предыдущего ответа",
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "dateField",
      "includeDescription",
      "descriptionMaxChars"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "returnedCount": {
                "type": "number"
              }
            },
            "required": [
              "items",
              "returnedCount"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              },
              "attempts": {
                "type": "number"
              },
              "page": {
                "type": "object",
                "properties": {
                  "nextCursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hasMore": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "nextCursor",
                  "hasMore"
                ],
                "additionalProperties": false
              },
              "completeness": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "unknown"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "requestId",
              "durationMs",
              "completeness",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "CONFIG_INVALID",
                  "BITRIX_AUTH_FAILED",
                  "BITRIX_SCOPE_MISSING",
                  "BITRIX_ACCESS_DENIED",
                  "BITRIX_APP_CONTEXT_REQUIRED",
                  "FEATURE_UNAVAILABLE",
                  "METHOD_NOT_ALLOWED",
                  "VALIDATION_ERROR",
                  "BITRIX_RATE_LIMITED",
                  "BITRIX_RESOURCE_LIMITED",
                  "BITRIX_TIMEOUT",
                  "BITRIX_UPSTREAM_ERROR",
                  "OPERATION_OUTCOME_UNKNOWN",
                  "NOT_FOUND",
                  "READ_ONLY_MODE",
                  "APPROVAL_REQUIRED",
                  "APPROVAL_EXPIRED",
                  "APPROVAL_MISMATCH",
                  "CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "PARTIAL_SUCCESS",
                  "FILE_TOO_LARGE",
                  "UNSAFE_FILE",
                  "AUDIT_UNAVAILABLE",
                  "ACCESS_DENIED",
                  "RATE_LIMITED",
                  "QUOTA_EXCEEDED",
                  "SUBSCRIPTION_INACTIVE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string",
                "enum": [
                  "legacy",
                  "v3"
                ]
              },
              "durationMs": {
                "type": "number"
              }
            },
            "required": [
              "requestId",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "error",
          "meta"
        ],
        "additionalProperties": false
      }
    ]
  }
}

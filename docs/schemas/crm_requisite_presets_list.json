        "description": "ID страны шаблона (crm.requisite.preset.countries; 1 — RU)",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "activeOnly": {
        "default": true,
        "description": "Только активные шаблоны",
        "type": "boolean"
      },
      "includeFields": {

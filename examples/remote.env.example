# Профиль удалённого сервера (ТЗ §17.6, §18.3, этап 12): HTTPS reverse proxy перед сервером,
# OAuth-защита MCP по спецификации MCP Authorization (S25). Это НЕ OAuth Bitrix24.
# Скопируйте в config/.env на VPS, заполните и выставьте права 600. Пути задаёт compose.yaml.
NODE_ENV=production
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Канонический публичный адрес сервера = значение `resource`/`aud` для токенов (RFC 8707)
MCP_PUBLIC_URL=https://mcp.example.com/mcp

MCP_AUTH_MODE=oauth
# Издатель токенов (authorization server): точная строка `iss` из его метаданных
MCP_AUTH_ISSUER=https://auth.example.com/realms/mcp
# Пусто = MCP_PUBLIC_URL без завершающего `/`
MCP_AUTH_AUDIENCE=
MCP_AUTH_JWKS_URI=https://auth.example.com/realms/mcp/protocol/openid-connect/certs
# Кто может подключаться: значения `sub` из токенов, через запятую. Пусто = никто.
MCP_AUTH_ALLOWED_SUBJECTS=
# Браузерные Origin (если клиент — веб-приложение); серверные клиенты Origin не шлют
MCP_ALLOWED_ORIGINS=
# Пусто = хост из MCP_PUBLIC_URL
MCP_ALLOWED_HOSTS=
MCP_INBOUND_READ_PER_MINUTE=60

BITRIX_AUTH_MODE=webhook
BITRIX_PORTAL_URL=https://your-portal.bitrix24.ru
BITRIX_WEBHOOK_BASE_URL=
ENABLED_MODULES=system,crm,tasks,chat,disk,calendar
READ_ONLY_MODE=true
CONFIRM_ALL_WRITES=true
CONFIRM_DESTRUCTIVE_ACTIONS=true
LOG_LEVEL=info
# Загрузка файлов в удалённом режиме — только со сканером (ТЗ §8.5); панель и web-upload — следующий срез
UPLOAD_SCAN_REQUIRED=true
UPLOAD_SCANNER_URL=

# Переменные SaaS-профиля (SaaS-ТЗ §15; этап S8). Скопируйте в saas.env (права 600, в Git не попадает —
# deploy/saas/.gitignore). Значения в <угловых скобках> — заполнить; секретов в этом файле-примере нет.
# Файлы секретов (*_FILE) монтируются compose-секретами в /run/secrets.

# --- режим и роль процесса ---
DEPLOYMENT_MODE=saas
# PROCESS_ROLE=web|worker задаётся в docker-compose.yml для каждого сервиса
PUBLIC_BASE_URL=https://mcp.example.com
MCP_TRANSPORT=http
MCP_AUTH_MODE=oauth
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_ORIGINS=https://mcp.example.com
LOG_LEVEL=info

# --- PostgreSQL (секрет: пароль роли mcp_app = содержимое secrets/pg_app_password) ---
# Роль без SUPERUSER/BYPASSRLS создаёт postgres-init/10-roles.sh; внешний сервер — добавьте ?sslmode=verify-full
DATABASE_URL=postgres://mcp_app:<пароль-mcp_app>@postgres:5432/mcp

# --- Redis (секрет: пароль = содержимое secrets/redis_password; rediss:// — TLS до управляемого Redis) ---
REDIS_URL=redis://:<пароль-redis>@redis:6379/0
REDIS_NAMESPACE=mcp:
REDIS_COMMAND_TIMEOUT_MS=3000

# --- ключи ---
# KEK (32 байта) — вне БД и вне бэкапов; резервная копия KEK хранится отдельно от копий PostgreSQL
KEK_FILE=/run/secrets/kek
# KMS_* — при использовании KMS провайдера вместо файла (не реализовано в v1)
OAUTH_SIGNING_KEYS_DIR=/app/data/oauth-keys

# --- тиражное приложение Bitrix24 (§8) ---
B24_APP_CLIENT_ID=<client_id приложения>
B24_APP_CLIENT_SECRET_FILE=/run/secrets/b24_client_secret

# --- ЮKassa (§10) ---
YOOKASSA_SHOP_ID=<shopId>
YOOKASSA_SECRET_KEY_FILE=/run/secrets/yookassa_secret_key

# --- реквизиты продавца для чеков и счетов (§10.1; до заполнения боевые чеки не включаются, §20) ---
SELLER_INN=<ИНН>
SELLER_NAME=<наименование>
SELLER_TAX_SYSTEM=<код системы налогообложения>
SELLER_VAT_CODE=<код ставки НДС>

# --- почта ---
SMTP_URL=smtp://<пользователь>@<smtp-хост>:587
MAIL_FROM=MCP для Bitrix24 <noreply@example.com>

# --- лимиты Bitrix24 на портал (общие для кластера через Redis, S15) ---
BITRIX_REQUESTS_PER_SECOND=2
BITRIX_MAX_CONCURRENCY=4
BITRIX_MAX_QUEUE_SIZE=100
# запасной лимит на экземпляр, если Redis недоступен (по умолчанию rps/2)
PORTAL_LIMIT_FALLBACK_RPS=1

# --- worker (лидер через аренду в Redis) ---
WORKER_LEASE_TTL_MS=15000
WORKER_RENEW_INTERVAL_MS=5000
WORKER_SHUTDOWN_GRACE_MS=25000
# пусто — все задачи; имена: usage.flush, billing.renewals, bitrix.app_info, retention.cleanup, oauth.dcr_cleanup
WORKER_TASKS=
WORKER_TASK_INTERVALS=usage.flush=60000,billing.renewals=3600000,bitrix.app_info=86400000

# --- аварийный выключатель записи (§15) ---
READ_ONLY_MODE=false

# Шаблон конфигурации bitrix24-mcp-server (ТЗ §13). Действующих секретов здесь нет.
# Скопируйте в .env (cp .env.example .env), заполните и НИКОГДА не коммитьте .env.
# Пустое секретное значение — не разрешение запускать небезопасный режим.

# ---------- Основной профиль: один пользователь, локальный stdio, входящий вебхук ----------
NODE_ENV=development
MCP_SERVER_NAME=bitrix24-mcp-server
# stdio — для Claude Code / Claude Desktop; http — loopback Streamable HTTP
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_PUBLIC_URL=
LOCAL_PRINCIPAL_ID=owner

# Способ связи с Bitrix24. В MVP поддерживается только webhook.
BITRIX_AUTH_MODE=webhook
# Адрес портала без путей, например https://example.bitrix24.ru
BITRIX_PORTAL_URL=
# Секретный базовый URL входящего вебхука ЦЕЛИКОМ, без имени метода:
# https://example.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
BITRIX_WEBHOOK_BASE_URL=
# Дополнительные разрешённые hosts через запятую; пусто = только origin портала
BITRIX_ALLOWED_HOSTS=
# cloud | on-premise
BITRIX_DEPLOYMENT=cloud
DEFAULT_TIMEZONE=Europe/Moscow

# ---------- Модули, режим записи, политики ----------
# Модули MVP; все доступные: system,company,crm,tasks,calendar,chat,telephony,disk,knowledgeBase,smartProcesses,
# catalog,invoices,orders,feed,groups,openlines,lists — включайте только нужные и выдавайте вебхуку только их scope (docs/bitrix-webhook.md)
ENABLED_MODULES=system,crm,tasks,chat,disk,calendar
# Пока true — ни один инструмент не изменяет портал
READ_ONLY_MODE=true
CONFIRM_ALL_WRITES=true
CONFIRM_DESTRUCTIVE_ACTIONS=true
ENABLE_DESTRUCTIVE_TOOLS=false
ENABLE_RAW_REST=true
# read-only — единственный режим MVP
RAW_REST_MODE=read-only
METHOD_POLICY_FILE=./policies/methods.json
ACCESS_POLICY_FILE=./policies/access.json
OUTPUT_POLICY_FILE=./policies/output.json

# ---------- Хранилище ----------
DATA_DIR=./data
DATABASE_URL=file:./data/mcp.sqlite
SECRETS_KEY_FILE=./data/secrets/master.key
APPROVAL_TTL_SECONDS=600
IDEMPOTENCY_TTL_HOURS=168
CURSOR_TTL_SECONDS=600

# ---------- Логи и аудит ----------
LOG_LEVEL=info
LOG_BODY=false
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90
LOG_RETENTION_DAYS=14

# ---------- Лимиты обращений к Bitrix24 ----------
BITRIX_TIMEOUT_MS=20000
BITRIX_UPLOAD_TIMEOUT_MS=60000
BITRIX_MAX_READ_RETRIES=3
BITRIX_REQUESTS_PER_SECOND=1
BITRIX_MAX_CONCURRENCY=2
BITRIX_MAX_QUEUE_SIZE=100
MAX_RESPONSE_BYTES=65536
MAX_UPSTREAM_RESPONSE_BYTES=5242880
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=50
MAX_AGGREGATION_RECORDS=5000
MAX_AGGREGATION_SECONDS=30

# ---------- Файлы ----------
UPLOAD_ROOT=./data/inbox
STAGING_DIR=./data/staging
MAX_UPLOAD_BYTES=10485760
MAX_INLINE_FILE_BYTES=262144
UPLOAD_TTL_SECONDS=86400
UPLOAD_SCAN_REQUIRED=false
# ClamAV: clamd://127.0.0.1:3310 или clamd+unix:///var/run/clamav/clamd.ctl; обязателен при UPLOAD_SCAN_REQUIRED=true
UPLOAD_SCANNER_URL=
# Панель подтверждений и web-upload /admin (только http-транспорт; пользователи — npm run admin:user)
ADMIN_PANEL_ENABLED=false
ALLOW_REMOTE_FILE_URLS=false

# ---------- Удалённый MCP (этап 12, не является Bitrix OAuth) ----------
# local — только stdio или loopback dev; oauth — обязателен для внешнего интерфейса
MCP_AUTH_MODE=local
MCP_AUTH_ISSUER=
MCP_AUTH_AUDIENCE=
MCP_AUTH_JWKS_URI=
MCP_AUTH_ALLOWED_SUBJECTS=
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=
# ТЗ §8.6: входящие read-вызовы на оператора в минуту (write-подготовки: 10/мин, фиксировано)
MCP_INBOUND_READ_PER_MINUTE=60

# ---------- OAuth Bitrix24 (будущий этап; блок не нужен при webhook) ----------
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_REDIRECT_URI=
BITRIX_INSTALL_URL=
BITRIX_OAUTH_TOKEN_ENDPOINT=
BITRIX_EXPECTED_MEMBER_ID=
# Только одноразовый локальный bootstrap/import, не рабочее хранилище:
BITRIX_ACCESS_TOKEN=
BITRIX_REFRESH_TOKEN=

# ---------- Режим развёртывания (SaaS-ТЗ docs/saas/TZ-SaaS.md §15) ----------
# single — один портал, вебхук, SQLite (всё, что выше). saas — сервис по подписке (PostgreSQL, Redis, тиражное
# приложение Bitrix24, сервер авторизации MCP, биллинг): полный пример — deploy/saas/saas.env.example,
# описание сборки — docs/saas/runtime.md.
DEPLOYMENT_MODE=single
# Только для saas: публичный https-origin сервиса, PostgreSQL, Redis, роль процесса web|worker
# PUBLIC_BASE_URL=https://mcp.example.ru
# DATABASE_URL=postgres://mcp:<пароль>@db.internal:5432/mcp
# REDIS_URL=rediss://:<пароль>@cache.internal:6380/0
# PROCESS_ROLE=web
# KEK_FILE=./secrets/kek.key                     # главный ключ шифрования (32 байта), вне бэкапов БД
# B24_APP_CLIENT_ID=app.xxxxxxxx.xxxxxxxx         # тиражное/локальное приложение Bitrix24
# B24_APP_CLIENT_SECRET_FILE=./secrets/b24-client-secret
# B24_OAUTH_SERVER_URL=https://oauth.bitrix.info  # сверить с документацией OAuth Bitrix24
# OAUTH_SIGNING_KEYS_DIR=./secrets/oauth-keys     # ключи подписи access-токенов сервиса
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY_FILE=./secrets/yookassa-secret-key
# SELLER_NAME=  SELLER_INN=  SELLER_TAX_SYSTEM_CODE=  SELLER_VAT_CODE=   # реквизиты для чеков 54-ФЗ
# SMTP_URL=smtps://user:<пароль>@smtp.example.ru:465
# MAIL_FROM=noreply@example.ru

# ---------- Только для явно запускаемых live-тестов ----------
LIVE_TESTS_ENABLED=false
LIVE_TEST_PREFIX=[MCP TEST]
TEST_RESPONSIBLE_USER_ID=
TEST_CRM_CATEGORY_ID=
TEST_CRM_STAGE_ID=
TEST_CHAT_DIALOG_ID=
TEST_DISK_FOLDER_ID=
TEST_CALENDAR_TYPE=user
TEST_CALENDAR_OWNER_ID=
TEST_CALENDAR_SECTION_ID=

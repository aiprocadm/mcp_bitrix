# Профиль для тестов и smoke без реального портала. Секрет вымышленный, домен .invalid никуда не ведёт.
NODE_ENV=test
MCP_TRANSPORT=stdio
BITRIX_AUTH_MODE=webhook
BITRIX_PORTAL_URL=https://mock.bitrix24.invalid
BITRIX_WEBHOOK_BASE_URL=https://mock.bitrix24.invalid/rest/7/mocksecret0123456789/
ENABLED_MODULES=system,company,crm,tasks,calendar,chat,telephony,disk,knowledgeBase,smartProcesses,catalog,invoices,orders,feed,groups,openlines,lists
READ_ONLY_MODE=true
LOG_LEVEL=silent
METHOD_POLICY_FILE=../../policies/methods.example.json
ACCESS_POLICY_FILE=../../policies/access.example.json
OUTPUT_POLICY_FILE=../../policies/output.example.json
DATA_DIR=../../data/test
DATABASE_URL=file:../../data/test/mcp.sqlite
SECRETS_KEY_FILE=../../data/test/secrets/master.key
UPLOAD_ROOT=../../data/test/inbox
STAGING_DIR=../../data/test/staging
MCP_INBOUND_READ_PER_MINUTE=100000
